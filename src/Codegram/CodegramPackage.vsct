<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <Include href="KnownImageIds.vsct" />

  <Commands package="guidCodegramPackage">
    <Buttons>
      <!-- View > Other Windows > Codesight -->
      <Button guid="guidCodegramCmdSet" id="ShowCodegram" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <Icon guid="guidCodesightImages" id="bmpLogo" />
        <Strings>
          <ButtonText>Codesight</ButtonText>
          <!-- lets people bind a shortcut, and run it from the command window as View.Codesight -->
          <CanonicalName>.View.Codesight</CanonicalName>
          <LocCanonicalName>.View.Codesight</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
    <Bitmaps>
      <Bitmap guid="guidCodesightImages" href="Resources\codesight-menu.png" usedList="bmpLogo" />
    </Bitmaps>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidCodegramPackage" value="{aff7ea1f-b886-4cd9-b1b0-4a95b44cbd1e}" />
    <GuidSymbol name="guidCodegramCmdSet" value="{143b2144-7207-4da3-9ed1-e53eb6c13eee}">
      <IDSymbol name="ShowCodegram" value="0x0100" />
    </GuidSymbol>
    <GuidSymbol name="guidCodesightImages" value="{2a1dc62d-6bdc-435f-86f1-d348eaf8fc18}">
      <IDSymbol name="bmpLogo" value="1" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
